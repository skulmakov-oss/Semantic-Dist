{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/skulmakov-oss/Semantic-Dist/main/manifests/governance_request_schema.json",
  "title": "GovernanceRequestManifest",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "pr_number",
    "base_sha",
    "head_sha",
    "operation",
    "authorized_paths",
    "justification"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "request_id": {
      "type": "string",
      "pattern": "^GOV-[A-Z0-9_-]+$"
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "operation": {
      "type": "string",
      "enum": [
        "workflow-addition",
        "workflow-modification",
        "ci-tooling-update",
        "governance-policy-update",
        "upstream-anchor-transition"
      ]
    },
    "authorized_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "justification": {
      "type": "string",
      "minLength": 10
    },
    "expected_post_merge_verification": {
      "type": "string"
    }
  }
}
