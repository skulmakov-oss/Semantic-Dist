{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/skulmakov-oss/Semantic-Dist/main/manifests/governance_request_schema.json",
  "title": "GovernanceAuthorizationBlock",
  "type": "object",
  "required": [
    "version",
    "decision",
    "repository",
    "pr_number",
    "base_sha",
    "head_sha",
    "authorized_paths"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "decision": {
      "type": "string",
      "enum": ["OWNER GOVERNANCE GO"]
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "authorized_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "justification": {
      "type": "string"
    }
  }
}
